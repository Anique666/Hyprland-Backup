# ============================================
# Hyprland - Binnewbs Rice + Working Setup
# Fedora 44 / Hyprland 0.56.2
# ============================================


# ============================================
# VARIABLES
# ============================================

$terminal = kitty
$menu = wofi --show drun
$fileManager = thunar

source = ~/.config/hypr/colors.conf


# ============================================
# STARTUP
# ============================================

# Waybar
exec-once = waybar & 
#-c ~/.config/waybar/configs/'bintang default' -s ~/.config/waybar/style/'bintang default.css'

# Wallpaper daemon
exec-once = awww-daemon

# Notification center
exec-once = swaync

# Idle daemon
exec-once = hypridle

# Network / Bluetooth
exec-once = nm-applet
exec-once = blueman-applet

# Polkit authentication agent
exec-once = systemctl --user start hyprpolkitagent

# Clipboard history
exec-once = wl-paste --type text --watch cliphist store
exec-once = wl-paste --type image --watch cliphist store


# ============================================
# ENVIRONMENT
# ============================================

env = XCURSOR_SIZE,24
env = HYPRCURSOR_SIZE,24

# ============================================
# MONITORS
# ============================================

monitor = eDP-1, preferred, auto, 1
monitor = HDMI-A-1, preferred, auto, 1


# WORKSPACES

# Laptop display
workspace = 1, monitor:eDP-1, default:true

# External display
workspace = 2, monitor:HDMI-A-1
workspace = 3, monitor:HDMI-A-1
workspace = 4, monitor:HDMI-A-1
workspace = 5, monitor:HDMI-A-1
workspace = 6, monitor:HDMI-A-1
workspace = 7, monitor:HDMI-A-1
workspace = 8, monitor:HDMI-A-1
workspace = 9, monitor:HDMI-A-1
workspace = 10, monitor:HDMI-A-1


# WORKSPACE KEYBINDS
bind = SUPER, 1, workspace, 1
bind = SUPER, 2, workspace, 2
bind = SUPER, 3, workspace, 3
bind = SUPER, 4, workspace, 4
bind = SUPER, 5, workspace, 5
bind = SUPER, 6, workspace, 6
bind = SUPER, 7, workspace, 7
bind = SUPER, 8, workspace, 8
bind = SUPER, 9, workspace, 9
bind = SUPER, 0, workspace, 10

# MOVE WINDOWS TO WORKSPACES
bind = SUPER SHIFT, 1, movetoworkspace, 1
bind = SUPER SHIFT, 2, movetoworkspace, 2
bind = SUPER SHIFT, 3, movetoworkspace, 3
bind = SUPER SHIFT, 4, movetoworkspace, 4
bind = SUPER SHIFT, 5, movetoworkspace, 5
bind = SUPER SHIFT, 6, movetoworkspace, 6
bind = SUPER SHIFT, 7, movetoworkspace, 7
bind = SUPER SHIFT, 8, movetoworkspace, 8
bind = SUPER SHIFT, 9, movetoworkspace, 9
bind = SUPER SHIFT, 0, movetoworkspace, 10

# ============================================
# GENERAL / LAYOUT
# ============================================

general {
    gaps_in = 5
    gaps_out = 10

    border_size = 2


col.active_border = $primary $secondary
col.inactive_border = $secondary_container

    layout = dwindle

    resize_on_border = false
    allow_tearing = false
}


# ============================================
# DECORATION
# ============================================

decoration {
    rounding = 10
    rounding_power = 2

    active_opacity = 1.0
    inactive_opacity = 0.95

    shadow {
        enabled = false
    }

    blur {
        enabled = true
        size = 5
        passes = 0

        ignore_opacity = true
        new_optimizations = true
        special = false
        popups = true
        xray = false

        vibrancy = 0.1696
    }
}


# ============================================
# INPUT
# ============================================

input {
    kb_layout = us

    follow_mouse = 1

    touchpad {
        natural_scroll = true
    }
}


# ============================================
# BRIGHTNESS
# ============================================

bindel = , XF86MonBrightnessUp, exec, brightnessctl set 5%+
bindel = , XF86MonBrightnessDown, exec, brightnessctl set 5%-


# ============================================
# VOLUME
# ============================================

bindel = , XF86AudioRaiseVolume, exec, wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+
bindel = , XF86AudioLowerVolume, exec, wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-
bind = , XF86AudioMute, exec, wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle


# ============================================
# TERMINAL
# ============================================

bind = SUPER, Return, exec, $terminal


# ============================================
# APPLICATION LAUNCHER
# ============================================

bind = SUPER, D, exec, $menu


# ============================================
# FILE MANAGER
# ============================================

bind = SUPER, E, exec, $fileManager


# ============================================
# WINDOW MANAGEMENT
# ============================================

# Close window
bind = SUPER, Q, killactive

# Toggle floating
bind = SUPER, V, togglefloating

# Reload Hyprland
bind = SUPER, R, exec, hyprctl reload

# Exit Hyprland
bind = SUPER, M, exit


# ============================================
# FOCUS
# ============================================

bind = SUPER, left, movefocus, l
bind = SUPER, right, movefocus, r
bind = SUPER, up, movefocus, u
bind = SUPER, down, movefocus, d


# ============================================
# MOVE WINDOWS
# ============================================

bind = SUPER SHIFT, left, movewindow, l
bind = SUPER SHIFT, right, movewindow, r
bind = SUPER SHIFT, up, movewindow, u
bind = SUPER SHIFT, down, movewindow, d




# ============================================
# CLIPBOARD
# ============================================

bind = SUPER, C, exec, cliphist list | wofi --dmenu | cliphist decode | wl-copy


# ============================================
# MOUSE
# ============================================

bindm = SUPER, mouse:272, movewindow
bindm = SUPER, mouse:273, resizewindow
# Screenshot
bind = SUPER SHIFT, S, exec, ~/.config/hypr/scripts/screenshot.sh



#Lock Screen

bind = SUPER, L, exec, hyprlock


#Media Controls
bind = , XF86AudioNext, exec, playerctl next
bind = , XF86AudioPrev, exec, playerctl previous
